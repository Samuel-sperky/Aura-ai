# =============================================================================
# Docker build context excludes
# =============================================================================
# Keep the build context small and NEVER ship secrets or host-built artifacts
# into the image. node_modules and .next are rebuilt inside the image from the
# lockfile + source, so they must be excluded (host artifacts may be the wrong
# platform/arch — Windows or glibc — and would poison the alpine build).

# Dependencies (reinstalled via `npm ci` in the deps stage)
node_modules
.pnp
.pnp.*
.yarn

# Build output (regenerated by `next build` in the build stage)
.next
out
build
dist

# Version control / CI
.git
.gitignore
.github

# Secrets & local env — these come from compose `env_file` at runtime and must
# never be baked into an image layer.
.env
.env.*
!.env.example

# Deploy/infra files not needed inside the image
Dockerfile
.dockerignore
docker-compose*.yml

# Backups (local mysqldump output — never goes into an image)
backups

# Tests / reports
coverage
e2e
playwright.config.ts
playwright-report
test-results

# Project docs / contract
docs
*.md

# Editor / OS cruft
.vscode
.idea
.DS_Store
Thumbs.db

# Logs & misc local junk
*.log
npm-debug.log*
*.tsbuildinfo
next-env.d.ts
*.stackdump
