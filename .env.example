# =============================================================================
# Aura Roadmap — environment configuration (example / documentation)
# =============================================================================
# LOCAL DEV:  cp .env.example .env.local   → fill in, then `npm run keys:gen`
# DOCKER:     cp .env.example .env         → fill in, then
#             docker compose --env-file .env up -d --build
#
# ⚠ THERE ARE NO DEV FALLBACKS. src/lib/env.ts is fail-closed in EVERY
#   environment: a missing or too-short SESSION_SECRET throws at boot. This is a
#   deliberate correction of the family reference, which shipped a hard-coded dev
#   SESSION_SECRET that made forging a session JWT trivial.
#
# ⚠ ALWAYS pass `--env-file .env` to docker compose. Without it the ${...}
#   interpolations in docker-compose.yml resolve to empty and MariaDB boots with
#   no database and no app user.
#
# This file is COMMITTED as documentation — the placeholders below are NOT valid
# secrets. Never commit .env / .env.local (both are gitignored).
# =============================================================================

# Node environment: development | test | production
NODE_ENV=development

# --- MariaDB (the app database) ----------------------------------------------
# Backend-only; never exposed to the browser. Inside docker compose the app
# overrides DB_HOST/DB_PORT to the `db` service, so these host values matter only
# for a native run.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aura_roadmap
DB_PASSWORD=replace_me_with_a_strong_db_password
DB_DATABASE=aura_roadmap

# Root password for the MariaDB container. Used ONLY by docker-compose.yml
# (MARIADB_ROOT_PASSWORD) and by scripts/backup/backup.ps1 for mysqldump.
# The app itself never uses it.
DB_ROOT_PASSWORD=replace_me_with_a_strong_root_password

# --- Session -----------------------------------------------------------------
# Signs the session JWT (jose HS256). MUST be >= 32 chars. Generate with:
#   npm run keys:gen        (or: openssl rand -base64 48)
SESSION_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Session lifetime in seconds (optional, default 28800 = 8 hours).
SESSION_TTL_SECONDS=28800

# --- Secrets at rest (AES-256-GCM) -------------------------------------------
# 32-byte key, base64-encoded. Generate with `npm run keys:gen`.
SECRETS_ENC_KEY=replace_me_with_base64_of_32_random_bytes

# --- First admin (consumed by `npm run db:seed`, then no longer needed) ------
# The seed creates this account with an argon2id password hash. Change the
# password in-app afterwards; ADMIN_PASSWORD must be >= 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me_min_12_chars

# --- Networking --------------------------------------------------------------
# Number of TRUSTED reverse proxies between the public edge and this app.
# 0 (default) = the app is the edge → forwarding headers are IGNORED (they are
# client-forgeable, and trusting them lets an attacker reset the per-IP login
# lockout and the rate limits). Set to 1 only when a real proxy (ngrok, Caddy)
# is in front and overwrites X-Real-IP.
TRUSTED_PROXY_HOPS=0

# --- ngrok tunnel (PREPARED, DISABLED — see docker-compose.ngrok.yml) --------
# Leave empty unless you deliberately expose the app publicly.
NGROK_AUTHTOKEN=
